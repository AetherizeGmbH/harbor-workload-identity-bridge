# syntax=docker/dockerfile:1.27@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# Plugin image. Carries two binaries: the credential-provider plugin
# (copied onto the node; kubelet execs it there, never in a container)
# and the node installer (ADR-0021) that the chart's DaemonSet runs to
# wire the plugin into kubelet. The installer shells out to nsenter for
# the kubelet restart, so we use alpine rather than distroless.

# Pin the builder to the native build platform — under buildx, Go cross-
# compiles via GOARCH much faster than QEMU emulates the whole toolchain.
# (See Dockerfile.bridge for the v0.0.0 hang that motivated this.)
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY plugin ./plugin
COPY installer ./installer
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' \
    -o /out/harbor-bridge-plugin ./plugin
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' \
    -o /out/harbor-bridge-installer ./installer

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
COPY --from=builder /out/harbor-bridge-plugin /plugin/harbor-bridge-plugin
COPY --from=builder /out/harbor-bridge-installer /installer/harbor-bridge-installer
# Default to a non-root UID. The chart's install container overrides this
# to root (runAsUser: 0) because it writes onto the host, but defaulting
# the image to non-root is the safe baseline for any other use.
USER 65532:65532
